#!/bin/sh
# Stand-in for the docker CLI that prints demo data, so screenshots never show
# real containers. FAKE_DOCKER_MODE: normal (default) | empty | down | noperm
MODE="${FAKE_DOCKER_MODE:-normal}"

id() { printf '%064d' "$1" | tr '0123456789' 'a1b2c3d4e5' | sed "s/^.\{4\}/$(printf '%04x' "$1")/"; }

case "$MODE" in
    down)
        echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2
        exit 1 ;;
    noperm)
        echo "permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock: connect: permission denied" >&2
        exit 1 ;;
esac

# name|image|state|status|ports|ip
DATA='web-app|nginx:1.27|running|Up 3 hours (healthy)|0.0.0.0:8080->80/tcp, [::]:8080->80/tcp|172.18.0.2
api|node:20-alpine|running|Up 3 hours|0.0.0.0:3000->3000/tcp|172.18.0.3
db-postgres|postgres:16|running|Up 3 hours (healthy)|0.0.0.0:5432->5432/tcp|172.18.0.4
cache-redis|redis:7|running|Up 3 hours|0.0.0.0:6379->6379/tcp|172.18.0.5
mailpit|axllent/mailpit:latest|running|Up 2 hours|0.0.0.0:1025->1025/tcp, 0.0.0.0:8025->8025/tcp|172.18.0.6
search|elasticsearch:8.15.0|running|Up 20 minutes (unhealthy)|0.0.0.0:9200->9200/tcp|172.18.0.7
worker|python:3.12-slim|running|Up 6 seconds (health: starting)||172.18.0.8
queue-runner|python:3.12-slim|exited|Exited (137) 2 hours ago||
migrate|node:20-alpine|exited|Exited (0) 3 days ago||
adminer|adminer:4|exited|Exited (0) 5 days ago||
old-mysql|mysql:8.0|exited|Exited (0) 2 weeks ago||'
[ "$MODE" = empty ] && DATA=''

rows() { [ -n "$DATA" ] && printf '%s\n' "$DATA" | awk -F'|' '{print NR "|" $0}'; }

case "$1" in
    ps)
        if [ "$2" = "-q" ]; then
            rows | while IFS='|' read -r n name image state status ports ip; do
                [ "$state" = running ] && id "$n"; echo; done | sed '/^$/d'
        else
            rows | while IFS='|' read -r n name image state status ports ip; do
                printf '{"ID":"%s","Names":"%s","Image":"%s","State":"%s","Status":"%s","Ports":"%s"}\n' \
                    "$(id "$n")" "$name" "$image" "$state" "$status" "$ports"; done
        fi ;;
    inspect)
        rows | while IFS='|' read -r n name image state status ports ip; do
            [ "$state" = running ] && echo "$(id "$n") $ip "; done ;;
    stats)
        echo "0.35%|42.1MiB / 15.5GiB" ;;
    start|stop|restart)
        sleep 1; echo "$2" ;;
esac
exit 0
